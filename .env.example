# Environment Configuration
APP_ENV=development
APP_NAME="Compensation Disparity Analysis System"
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database (Default: SQLite local file)
DATABASE_URL=sqlite:///./compensation_equity.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/compensation_equity

# Security & JWT
SECRET_KEY=dev-insecure-secret-key-change-in-production-20261022
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Analysis Engine Thresholds
DEFAULT_REPORTING_CURRENCY=USD
COMPA_RATIO_LOW_THRESHOLD=0.85
COMPA_RATIO_HIGH_THRESHOLD=1.15
BAND_POSITION_LOW_THRESHOLD=0.0
BAND_POSITION_HIGH_THRESHOLD=1.0
GROUP_MIN_SIZE=5
GROUP_OUTLIER_IQR_MULTIPLIER=1.5
GROUP_MAX_DEVIATION_PCT=0.20

# Synthetic Data
RANDOM_SEED=20261022
DATASET_PROFILE=full
